# Local development overrides for running against a real LLM.
#
# Copy to .env.local and run: docker compose --profile llm up
# Requires the GGUF model to be present in ./models/ first — see docs/LLM_SETUP.md.
#
# .env.local is gitignored; this example file is committed as the reference.

# "fake" (default, used by unit tests) | "llama-cpp" | "openai-compatible"
LLM_PROVIDER=llama-cpp

# Must include the /v1 suffix — the OpenAI-compatible client appends paths to it.
# Use http://llama-server:8000/v1 when the backend runs inside compose,
# or http://localhost:8000/v1 when running uvicorn directly on the host.
LLM_URL=http://llama-server:8000/v1

# Must match the filename passed to llama-server's -m flag in docker-compose.yml.
LLM_MODEL=mistral-7b-instruct-v0.2.Q4_K_M.gguf

# CPU inference is slow; raise this if you see timeouts on longer prompts.
LLM_TIMEOUT=120
